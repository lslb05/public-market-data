# Copie para .env localmente. Nunca comite credencial real.
DADOS_MERCADO_PUBLICO_LOG_LEVEL=INFO
DADOS_MERCADO_PUBLICO_DADOS_DIR=data
# Chave gratuita em https://fredaccount.stlouisfed.org/apikeys
DADOS_MERCADO_PUBLICO_FRED_API_KEY=coloque-a-sua-aqui
# Casa com o docker-compose.yml deste repositório; sobrescreva em produção.
DADOS_MERCADO_PUBLICO_POSTGRES_DSN=postgresql://dados:dados@localhost:5433/dados_mercado_publico
